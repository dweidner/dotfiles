	# Git Aliases
	# @see <https://github.com/GitAlias/gitalias>

[alias]
	a = add
	b = branch
	c = commit
	d = diff
	m = merge
	s = status
	w = whatchanged

	aa = add --all
	ap = add --patch
	co = checkout
	ca = commit --amend
	ci = commit --interactive
	cm = commit --message
	ss = status --short

	branches = branch -a
	tags = tag -n1 --list
	remotes = remote -v
	stashes = stash list
	contributors = shortlog --summary --numbered --no-merges

	search = !"f() { git rev-list --all | xargs git grep \"${@}\"; }; f"
	undo = reset --soft HEAD~1
	force-undo = reset --hard HEAD~1

# vim:ft=gitconfig
